<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ResearchProjectDef>
    <defName>Ferny_Bionics_PyrinthBionics_PyrinthArmItem</defName>
    <label>pyrinth arm</label>
    <description>Manufacture a bionic arm powered by Pyrinth crystals. It can unleash stored heat to cauterize wounds.</description>
    <baseCost>500</baseCost>
    <techLevel>Spacer</techLevel>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <prerequisites>
      <li>Bionics</li>
      <li>PyrinthBionics_Research</li>
    </prerequisites>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>Ferny_Bionics_PyrinthBionics_PyrinthEyeItem</defName>
    <label>pyrinth eye</label>
    <description>Manufacture an artificial visual organ powered by Pyrinth crystals, whose appearance has a hypnotic beauty.</description>
    <baseCost>500</baseCost>
    <techLevel>Spacer</techLevel>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <prerequisites>
      <li>Bionics</li>
      <li>PyrinthBionics_Research</li>
    </prerequisites>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>Ferny_Bionics_PyrinthBionics_PyrinthLegItem</defName>
    <label>pyrinth leg</label>
    <description>Manufacture a bionic leg powered by Pyrinth crystals. It can use stored heat to superheat water to create a jet that fuels powerful jumps.</description>
    <baseCost>500</baseCost>
    <techLevel>Spacer</techLevel>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <prerequisites>
      <li>Bionics</li>
      <li>PyrinthBionics_Research</li>
    </prerequisites>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>Ferny_Bionics_PyrinthBionics_PyrinthLiverItem</defName>
    <label>pyrinth liver</label>
    <description>Manufacture a bionic liver infused with Pyrinth. It can purify blood in one fell swoop, burning off contaminants.</description>
    <baseCost>500</baseCost>
    <techLevel>Spacer</techLevel>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <prerequisites>
      <li>Bionics</li>
      <li>PyrinthBionics_Research</li>
    </prerequisites>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>Ferny_Bionics_PyrinthBionics_PyrinthStomachItem</defName>
    <label>pyrinth stomach</label>
    <description>Manufacture a bionic stomach lined with Pyrinth that sterilizes food, making digestion a bit more efficient by cooking ingested matter.</description>
    <baseCost>500</baseCost>
    <techLevel>Spacer</techLevel>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <prerequisites>
      <li MayRequire="ludeon.rimworld.royalty">ArtificialMetabolism</li>
      <li>Bionics</li>
      <li>PyrinthBionics_Research</li>
    </prerequisites>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
  </ResearchProjectDef>
