<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/*[self::ThingDef or self::PyrinthBionics.PyrinthItemDef][defName="DeathrestApparatus"]</xpath>
    <match Class="PatchOperationConditional">
      <xpath>Defs/ResearchProjectDef[defName="Deathrest"]</xpath>
      <nomatch Class="PatchOperationAdd">
        <xpath>Defs</xpath>
        <value>
          <ResearchProjectDef>
            <defName>Deathrest</defName>
            <label>deathrest apparatus</label>
            <description>Manufacture an artificial secondary vascular system that unseals during deathrest, vastly improving the rate of hemogenic circulation and deathrest regeneration.

Can only be installed on pawns with the deathrest gene.</description>
            <baseCost>500</baseCost>
            <techLevel>Spacer</techLevel>
            <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
            <prerequisites Inherit="False">
              <li>I_SanguophageImplants</li>
            </prerequisites>
            <requiredResearchFacilities>
              <li>MultiAnalyzer</li>
            </requiredResearchFacilities>
          </ResearchProjectDef>
        </value>
      </nomatch>
    </match>
  </Operation>
