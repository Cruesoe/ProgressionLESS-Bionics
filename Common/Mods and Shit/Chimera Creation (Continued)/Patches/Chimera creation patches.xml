    <match Class="PatchOperationConditional">
      <xpath>Defs/ResearchProjectDef[defName="AnAl_ChimeraCreation"]</xpath>
      <nomatch Class="PatchOperationAdd">
        <xpath>Defs</xpath>
        <value>
          <ResearchProjectDef>
            <defName>AnAl_ChimeraCreation</defName>
            <label>adrenal heart (chimera)</label>
            <description>Manufacture a special bioferrite prosthetic that allows a chimera to further saturate its bloodstream with stress hormones and liquid energy during its rage speed. The chimera will be able to attack faster and move faster compared to normal rage speed. The prosthetic somewhat increases the chimera's metabolism, causing it to eat more.

This prosthetic is too painful to be installed on normal animals. It's still painful for chimeras when not in rage speed, but they can handle it due to their body being used to large quantities of stress hormones and liquid energy.</description>
            <baseCost>0</baseCost>
            <techLevel>Industrial</techLevel>
            <knowledgeCategory>Advanced</knowledgeCategory>
            <knowledgeCost>30</knowledgeCost>
            <tab>Anomaly</tab>
            <prerequisites Inherit="False">
              <li MayRequire="ludeon.rimworld.anomaly">AdvancedPsychicRituals</li>
              <li MayRequire="vanillaexpanded.vgeneticse">GR_HybridImplantology</li>
            </prerequisites>
          </ResearchProjectDef>
        </value>
      </nomatch>
    </match>
  </Operation>
