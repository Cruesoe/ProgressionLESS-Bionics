    <match Class="PatchOperationConditional">
      <xpath>Defs/ResearchProjectDef[defName="Ferny_SystemInterlink"]</xpath>
      <nomatch Class="PatchOperationAdd">
        <xpath>Defs</xpath>
        <value>
          <ResearchProjectDef>
            <defName>Ferny_SystemInterlink</defName>
            <label>system interlink</label>
            <description>Manufacture a mechlink upgrade which allows the mechanitor to interface with a mechanoid to boost its performance and reduce incoming damage. The user psychically links with their target, using their own brain as a backup for critical subsystems.

This implant can be self-installed without surgery.

This implant can be installed up to 3 times to boost its range, reduce cooldown and increase the number of ability charges.</description>
            <baseCost>1200</baseCost>
            <techLevel>Archotech</techLevel>
            <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
            <prerequisites Inherit="False">
              <li MayRequire="ludeon.rimworld.biotech">HighMechtech</li>
            </prerequisites>
          </ResearchProjectDef>
        </value>
      </nomatch>
    </match>
