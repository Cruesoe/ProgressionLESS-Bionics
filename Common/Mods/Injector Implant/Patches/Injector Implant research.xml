<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="InjectorImplant"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="InjectorImplant"]/recipeMaker</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="InjectorImplant"]</xpath>
            <value>
              <recipeMaker />
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="InjectorImplant"]/recipeMaker/researchPrerequisite</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="InjectorImplant"]/recipeMaker/researchPrerequisite</xpath>
            <value>
              <researchPrerequisite Inherit="False">Ferny_Bionics_BionicOrgans</researchPrerequisite>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="InjectorImplant"]/recipeMaker</xpath>
            <value>
              <researchPrerequisite Inherit="False">Ferny_Bionics_BionicOrgans</researchPrerequisite>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="InjectorImplant"]/recipeMaker/researchPrerequisites</xpath>
          <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="InjectorImplant"]/recipeMaker/researchPrerequisites</xpath>
            <value>
              <researchPrerequisites Inherit="False" />
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="InjectorImplant"]/recipeMaker</xpath>
            <value>
              <researchPrerequisites Inherit="False" />
            </value>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>